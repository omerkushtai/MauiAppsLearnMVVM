<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Views"
    Title="MVVMBBasic">

    <FlyoutItem Title="Welcome">
        <ShellContent
            Title="Welcome"
            Route="Welcome"
            ContentTemplate="{DataTemplate views:WelcomePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Calculator Age">
        <ShellContent
            Title="Calculator Age"
            Route="CalcAge"
            ContentTemplate="{DataTemplate views:CalcAgePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Math Calculator">
        <ShellContent
            Title="Math Calculator"
            Route="CalculatorPage"
            ContentTemplate="{DataTemplate views:CalculatorPage}"/>
    </FlyoutItem>
    <FlyoutItem Title="Temp Calculator">
        <ShellContent
            Title="Temp Calculator"
            Route="TemperatureCalculatorPage"
            ContentTemplate="{DataTemplate views:TemperatureCalculatorPage}"/>
    </FlyoutItem>
    <FlyoutItem Title="Currency Calculator">
        <ShellContent
            Title="Currency Calculator"
            Route="CurrencyCalculatorPage"
            ContentTemplate="{DataTemplate views:CurrencyCalculatorPage}"/>
    </FlyoutItem>


</Shell>

