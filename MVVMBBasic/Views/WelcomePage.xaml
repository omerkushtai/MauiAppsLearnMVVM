<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ViewModels"
    x:Class="Views.WelcomePage"
    x:DataType="vm:WelcomeViewModel"
    Title="Welcome">

    <VerticalStackLayout
        Padding="30"
        Spacing="25"
        VerticalOptions="Center">

        <Label
            Text="Welcome!"
            FontSize="32"
            HorizontalOptions="Center"
            FontAttributes="Bold"/>

        <Button
            Text="מחשבון גיל"
            Command="{Binding GoToAgeCommand}"/>

        <Button
            Text="מחשבון מתמטי"
            Command="{Binding GoToCalculatorCommand}"/>
        <Button
            Text="מחשבון טמפרטורה"
            Command="{Binding GoToTemperatureCalculatorCommand}"/>

    </VerticalStackLayout>
</ContentPage>
