<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ViewModels"
    x:Class="Views.CurrencyCalculatorPage"
    Title="Currency Calculator">

    <ContentPage.BindingContext>
        <vm:CurrencyCalculatorViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Currency Calculator"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Enter amount:"
            FontSize="18" />

        <Entry
            Placeholder="Enter amount"
            Keyboard="Numeric"
            Text="{Binding Amount}" />

        <Label Text="From currency:" />

        <Picker
            Title="Select currency"
            ItemsSource="{Binding Currencies}"
            SelectedItem="{Binding FromCurrency}" />

        <Label Text="To currency:" />

        <Picker
            Title="Select currency"
            ItemsSource="{Binding Currencies}"
            SelectedItem="{Binding ToCurrency}" />

        <Button
            Text="Convert"
            Command="{Binding ConvertCommand}" />

        <Label
            Text="{Binding Result}"
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Back to Welcome"
            Command="{Binding WelcomeCommand}"
            BackgroundColor="Gray" />

        <Label
            Text="Rates by ExchangeRate-API"
            FontSize="12"
            HorizontalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OpenRatesWebsite" />
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>
</ContentPage>